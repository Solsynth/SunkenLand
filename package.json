{
  "name": "@solsynth/sunkenland",
  "version": "0.1.0",
  "description": "Embeddable SunkenLand web components (sk-*) with a zod-validated Stargate API client.",
  "type": "module",
  "license": "MIT",
  "author": "Solar Network",
  "keywords": [
    "solar-network",
    "web-components",
    "custom-elements",
    "stargate",
    "solarpass",
    "oauth",
    "oauth2",
    "pkce",
    "sunkenland"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solsynth/SunkenLand.git"
  },
  "homepage": "https://github.com/Solsynth/SunkenLand#readme",
  "bugs": {
    "url": "https://github.com/Solsynth/SunkenLand/issues"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "test": "vitest",
    "build": "run-s type-check build:lib build:types",
    "build:lib": "vite build --config vite.lib.config.ts && mkdir -p dist/presets dist/stickers && cp presets/*.css dist/presets/ && cp stickers/*.webp dist/stickers/",
    "build:types": "vue-tsc -p tsconfig.lib.json",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "prepack": "npm run build"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "typescript": "npm:typescript-native-bridge@latest",
    "vite": "^8.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "storybook": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "lit": "latest",
    "vitest": "latest",
    "playwright": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/sunken-land.js",
  "module": "./dist/sunken-land.js",
  "types": "./dist/types/elements/index.d.ts",
  "unpkg": "./dist/sunken-land.iife.js",
  "jsdelivr": "./dist/sunken-land.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/elements/index.d.ts",
      "import": "./dist/sunken-land.js",
      "default": "./dist/sunken-land.js"
    },
    "./presets/*": "./dist/presets/*",
    "./stickers/*": "./dist/stickers/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
